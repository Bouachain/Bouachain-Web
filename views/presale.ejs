<section class="presale">
  <div class="container">
    <div class="row">
      <div class="col-md-8">
        <h1 style="font-size: 45px">
          Participate in our presale of <span>Bouacoin</span>.
        </h1>
        <p>Follow the guidelines below to participate</p>
      </div>
    </div>
    <div class="row mt-5 mb-5">
      <div class="col-md-6">
        <div class="brand-logo">
          <img src="/images/icon-2.png" class="img-fluid" alt="" />
        </div>
        <img src="" alt="" />
      </div>
      <div class="col-md-6">
        <div class="brand-snippet">
          <div class="d-flex mb-3">
            <p class="bold-7">Bouacoin Presale</p>
          </div>
          <h6>Boucoin Wallet Address</h6>
          <input type="text" id="bouaWallet" class="form-control bouaWallet"  style="border: 2px solid black;" name="bouaWallet">
          <p id="validAddress" class=""  style="font-size: 12px;">Input a valid Bouacoin address</p>
          <hr />
          <h6 class="mt-2">Buy Amount</h6>
          <div class="amount">
            <div class="row">
              <div class="col-7">
                <input
              type="number"
              min="0"
              class="number form-control"
              name=""
              id="theBuyAmount"
              placeholder="min order 500 USD"
            />
              </div>
              <div class="col-5">
                <div class="currency">
                  <select class="form-select form-control" aria-label="Default select example" id="currency">
                      <option value="ETH" selected>  Ethereum</option>
                      <option value="SOL"> Solana</option>
                      <option value="LTC"> Litecoin</option>
                      <option value="BNB"> Binance Coin</option>
                      <option value="TRX"> TRON</option>
                      <option value="BUSD"> Binance USD (BEP20)</option>
                      <option value="USDT"> Tether (TRC20)</option>
                      <option value="DASH"> DASH</option>
                      <option value="BTC"> BITCOIN</option>
                      <option value="BTT"> BIT TORRENT</option>
                      <option value="DOGE"> DOGE</option>
                    </select>
                  
                </div>
              </div>
            </div>
            
            <p style="font-size: 12px;" class="pt-2 mb-0">1 Boucoin = 0.5 USD</p>
            <p style="font-size: 12px;" class="mb-0">Recieve Amount = <span  id="theRA">0</span> Boua</p>
            <p style="font-size: 12px;" class="mb-0">Amount in USD = <span  id="theRU">0</span> USD</p>
            <p style="font-size: 12px;" class="red" id="min-amount-no"></p>
          </div>
          <hr/>
          <h6 class="mt-2">Number of Bouacoins</h6>
          <div class="amount">
            <input
              type="number"
              min="1000"
              class="number form-control"
              value="0"
              name=""
              id="totalBoua"
              placeholder="min order 500 USD"
            />
            <!-- <p style="font-size: 12px;" class="pt-2">1 Boucoin = 0.5 USD</p> -->
          </div>
          <!-- <hr /> -->

          <!-- <h6 class="mt-3">Currency</h6>
          <div class="currency">
            <select class="form-select form-control" aria-label="Default select example" id="currency">
                <option value="ETH" selected>  Ethereum</option>
                <option value="SOL"> Solana</option>
                <option value="LTC"> Litecoin</option>
                <option value="BNB"> Binance Coin</option>
                <option value="TRX"> TRON</option>
                <option value="BUSD"> Binance USD (BEP20)</option>
                <option value="USDT"> Tether (TRC20)</option>
                <option value="DASH"> DASH</option>
                <option value="BTC"> BITCOIN</option>
                <option value="BTT"> BIT TORRENT</option>
                <option value="DOGE"> DOGE</option>
              </select>
            
          </div>
          <hr /> -->
          <p id="callbackAddress"></p>
          <hr />
          <a
            class="btn btn-2 form-control"
            id="fetchButton"
            >Buy Presale</a
          >
          <hr />
          <p>
            Please direct any and all other <br />
            enquiries to presale@Bouachain.com
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
<div class="modal fade  presale-modal" id="myModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Make Payment</h5>
      </div>
      <div class="modal-body">
        <p>Make a Payment of: <span id="payAmmount"></span> <span id="paymentCurrency"></span></p>
        <p>To Recieve: <span id="recieveAmmount">----</span> Bouacoin</p>
        <img id="qrcode">
        <div class="d-flex">
          <p class="pt-2 mb-0 pb-0" style="font-size: 10px;">
              <span id="payWallet">Sample Text to Copy</span>
          </p>
          <button id="copyButton" class="ms-auto btn btn-1">
              Copy <i class="bi bi-clipboard2-check"></i>
          </button>
          
      </div>
      <hr>
          <button class="btn btn-2 form-control" id="ConfirmButton">I have made the payment!</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade  presale-modal" id="myModalTwo" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabelTwo" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabelTwo">Payment Verification</h5>
      </div>
      <div class="modal-body">
        <div id="verification-container">
          <div id="spinner"></div>
          <div id="status-text">Verifying payment...</div>
          <div id="countdown"></div>
          <p id="rrd"></p>
       </div>
  
      </div>
    </div>
  </div>
</div>